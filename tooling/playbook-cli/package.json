{
  "name": "@ai-engineering-playbook/cli",
  "version": "1.0.0",
  "description": "Cross-platform governance CLI for the AI Engineering Playbook",
  "license": "MIT",
  "type": "module",
  "bin": {
    "playbook": "./dist/src/bin/playbook.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/schemas', 'dist/src/schemas', {recursive: true});\"",
    "watch": "tsc --watch",
    "test": "node --test dist/tests/**/*.test.js",
    "pretest": "npm run build",
    "start": "node dist/src/bin/playbook.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
