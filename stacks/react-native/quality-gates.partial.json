{
  "stack": "react-native",
  "version": "1.0.0",
  "gates": [
    {
      "stage": 4,
      "stage_name": "Implementation & Local Verification",
      "checks": [
        {
          "id": "rn-typecheck",
          "name": "React Native TypeScript Strict Typecheck",
          "type": "build_typecheck",
          "deliverable_id": "CODE-IMPL",
          "command": "npx",
          "args": ["tsc", "--noEmit"],
          "inputs": ["src/**/*.{ts,tsx}", "App.tsx", "tsconfig.json"],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        },
        {
          "id": "rn-lint",
          "name": "React Native ESLint Validation",
          "type": "static_analysis",
          "deliverable_id": "CODE-IMPL",
          "command": "npx",
          "args": ["eslint", ".", "--max-warnings=0"],
          "inputs": ["src/**/*.{ts,tsx,js,jsx}", "App.tsx", "index.js", "eslint.config.{js,mjs}"],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        },
        {
          "id": "mobile-secret-audit",
          "name": "Mobile Secret & Env Leak Audit",
          "type": "security_audit",
          "deliverable_id": "CODE-IMPL",
          "command": "node",
          "args": ["scripts/audit-secrets.mjs"],
          "inputs": [".env*", "src/**/*.{ts,tsx,js,jsx}", "App.tsx", "scripts/audit-secrets.mjs"],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        },
        {
          "id": "rn-platform-companion",
          "name": "Platform File Companion Parity Audit",
          "type": "static_analysis",
          "deliverable_id": "CODE-IMPL",
          "command": "node",
          "args": ["scripts/audit-companions.mjs"],
          "inputs": ["src/**/*.{ts,tsx,js,jsx}", "scripts/audit-companions.mjs"],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        },
        {
          "id": "rn-accessibility",
          "name": "React Native Interactive Control Accessibility Audit",
          "type": "static_analysis",
          "deliverable_id": "CODE-IMPL",
          "command": "node",
          "args": ["scripts/audit-accessibility.mjs"],
          "inputs": ["src/**/*.{ts,tsx,js,jsx}", "App.tsx", "scripts/audit-accessibility.mjs"],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        }
      ]
    },
    {
      "stage": 5,
      "stage_name": "Integration & System Verification",
      "checks": [
        {
          "id": "rn-test",
          "name": "React Native Headless Unit & Component Tests",
          "type": "automated_test",
          "deliverable_id": "INTEG-TEST",
          "command": "npm",
          "args": ["test"],
          "inputs": [
            "src/**/*.{ts,tsx,js,jsx}",
            "__tests__/**/*.{ts,tsx,js,jsx}"
          ],
          "exclude": ["node_modules/**", "dist/**", "android/**", "ios/**"],
          "severity": "blocking"
        }
      ]
    }
  ]
}
